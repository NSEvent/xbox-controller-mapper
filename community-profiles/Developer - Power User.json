  "scripts" : [
    {
      "description" : "Captures the focused window and saves it to the Desktop as a PNG.",
      "modifiedAt" : "2026-02-22T11:48:41Z",
      "createdAt" : "2026-02-22T11:48:41Z",
      "id" : "B47B82BC-EF42-4C07-8056-BBE3BF192A54",
      "name" : "Screenshot Window to Desktop",
      "source" : "var ts = new Date().toISOString().replace(\/[:.]\/g, \"-\").slice(0, 19);\nvar path = \"~\/Desktop\/screenshot-\" + ts + \".png\";\nif (screenshotWindow(path)) {\n    notify(\"Saved to Desktop!\");\n} else {\n    notify(\"Failed — check Screen Recording permission\");\n}\nhaptic();"
    }
